# Public URL only, never database URLs, passwords, tokens or administrator credentials.
# For a published build: set VITE_API_URL to the actual API origin plus /api/v1.
# The API must explicitly allow the marketing website origin in CORS_ORIGINS.
# VITE_API_URL=https://YOUR_EXISTING_API_HOST/api/v1

# Development only: /api/v1 proxies to this backend (default shown).
MARKETING_API_PROXY_TARGET=http://127.0.0.1:3001
